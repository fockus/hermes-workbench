+# --- per-session tool filters (the tool-list hook) ---------------------------
+# Defined before plugin discovery below: a plugin's register() may add a filter while this module is
+# still importing. Plugins add fn(session_id, tools) -> tools through register_tool_filter; every filter
+# sees the session's raw catalog and may only remove tools. The names it hides leave the catalog before
+# tool_search builds its listing, so the assembled list, the bridge's listing and the catalog read by
+# tool_search agree, and the hidden set is part of the tool-defs cache key. A session records its
+# filters' keep/hide answer per tool name the first time a list holds that name, so a name never flips
+# mid-session (the prompt cache holds), while the list itself still follows the stock cache and its
+# check_fn expiry. A filter that raises hides, for that request only, every name not decided yet.
+_TOOL_FILTERS: list = []
+_tool_filters_lock = threading.Lock()
+_session_decided: dict[str, dict[str, bool]] = {}  # session -> {tool name: kept}
+_SESSION_MEMO_MAX = 512
+
+
+def register_tool_filter(fn) -> None:
+    """Add a per-session tool filter ``fn(session_id, tools) -> tools`` (registering one twice is a no-op)."""
+    with _tool_filters_lock:
+        if fn not in _TOOL_FILTERS:
+            _TOOL_FILTERS.append(fn)
+            _session_decided.clear()
+
+
+def unregister_tool_filter(fn) -> None:
+    """Remove a tool filter (its owner unloads) together with every session's recorded answers."""
+    with _tool_filters_lock:
+        if fn in _TOOL_FILTERS:
+            _TOOL_FILTERS.remove(fn)
+        _session_decided.clear()
+
+
+def _session_hidden_tools(session_id: Optional[str], enabled_toolsets: Optional[list[str]],
+                          disabled_toolsets: Optional[list[str]]) -> frozenset:
+    """The names this session's filters hide from its raw catalog; filters run only on names it has not decided."""
+    sid = session_id or ""
+    with _tool_filters_lock:
+        filters = list(_TOOL_FILTERS)
+        decided = dict(_session_decided.get(sid, {}))
+    if not filters:
+        return frozenset()
+    catalog = _tool_definitions(enabled_toolsets, disabled_toolsets, True, True, frozenset())
+    names = {t["function"]["name"] for t in catalog}
+    if names - decided.keys():
+        kept = set(names)
+        for fn in filters:
+            try:
+                filtered = fn(sid, list(catalog))
+            except Exception as exc:
+                logger.warning("tool filter %r failed; this request hides the tools it had not decided: %s", fn, exc)
+                return frozenset(name for name in names if not decided.get(name, False))
+            if isinstance(filtered, list):
+                kept &= {t["function"]["name"] for t in filtered if isinstance(t, dict) and "function" in t}
+        with _tool_filters_lock:
+            memo = _session_decided.get(sid)
+            if memo is None:
+                if len(_session_decided) >= _SESSION_MEMO_MAX:
+                    _session_decided.pop(next(iter(_session_decided)))
+                memo = _session_decided[sid] = {}
+            for name in names:
+                memo.setdefault(name, name in kept)
+            decided = dict(memo)
+    return frozenset(name for name in names if not decided.get(name, True))
+
+
+def filter_agent_tools(agent) -> None:
+    """Re-select an agent's tools[] for its session: AIAgent assembles it before the session id exists. A
+    delegated child is filtered once its parent's plugins have bound it (subagent_start, delegate_tool)."""
+    with _tool_filters_lock:
+        if not _TOOL_FILTERS:
+            return
+    enabled, disabled = getattr(agent, "enabled_toolsets", None), getattr(agent, "disabled_toolsets", None)
+    if not _session_hidden_tools(agent.session_id, enabled, disabled):
+        return
+    from toolsets import agent_tool_surface
+    agent.tools = agent_tool_surface(agent, get_tool_definitions(
+        enabled_toolsets=enabled, disabled_toolsets=disabled, quiet_mode=True, session_id=agent.session_id) or [])
+    agent.valid_tool_names = {tool["function"]["name"] for tool in agent.tools} if agent.tools else set()
+
+
